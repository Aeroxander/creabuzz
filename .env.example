# =============================================================================
# Buzz Backend — Local Development Environment
# =============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# All defaults here work with `docker compose up` out of the box.
#
# Service ports (defaults):
#   Postgres    → localhost:5432
#   Redis       → localhost:6379
#   Typesense   → localhost:8108
#   Adminer     → localhost:8082  (DB browser UI)
#
# Note: If port 8082 conflicts, change the adminer port in docker-compose.yml
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres 17)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://buzz:buzz_dev@localhost:5432/buzz
# Optional read-replica URL; unset/blank keeps all reads on the writer.
# READ_DATABASE_URL=postgres://buzz:buzz_dev@localhost:5433/buzz
PGHOST=localhost
PGPORT=5432
PGUSER=buzz
PGPASSWORD=buzz_dev
PGDATABASE=buzz

# Fleet usage telemetry is replica-only and independent of serving-read
# routing. This freshness budget defaults to 30000ms; 0 disables the database
# telemetry families. When the reader is absent, stale, or unavailable, the
# relay skips the collection and reports its availability as 0 instead of
# falling back to the writer.
# BUZZ_USAGE_METRICS_REPLICA_MAX_AGE_MS=30000
# Per-community metric series are disabled by default to bound relay memory and
# monitoring cardinality. `all` is the temporary rollback mode.
# BUZZ_USAGE_METRICS_PER_COMMUNITY=off

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Max connections in the relay's shared Redis pool (default 16).
# BUZZ_REDIS_POOL_SIZE=16

# Max connections in each of the relay's Postgres pools — writer and, when
# READ_DATABASE_URL is set, reader (default 50).
# BUZZ_DB_POOL_SIZE=50
# Read-only partition catalog audit interval, clamped to 60s..24h (default 900s).
# BUZZ_PARTITION_AUDIT_INTERVAL_SECS=900
# Emergency kill switch for all automatic partition DDL, including catch-all
# advancement; audits remain enabled.
# BUZZ_PARTITION_MANAGER_CREATE_ENABLED=true
# Opt in to replacing an empty partition catch-all with six months of dedicated
# monthlies, at startup and on every audit interval (default false). Has no
# effect while the kill switch above is off.
# BUZZ_PARTITION_MANAGER_ADVANCE_ENABLED=false

# Writer-session Postgres timeouts for buzz-db-backed pools and the relay audit
# pool, all in milliseconds; 0 disables.
# lock_timeout: fail a statement that waits this long on any lock instead of
# parking behind a wedged holder (default 5000).
# BUZZ_DB_LOCK_TIMEOUT_MS=5000
# idle_in_transaction_session_timeout: reap sessions idle inside an open
# transaction — bounds how long a wedged client can hold locks (default 60000).
# BUZZ_DB_IDLE_TXN_TIMEOUT_MS=60000
# statement_timeout: cap any single statement's runtime. Off by default —
# startup migrations/backfills legitimately run long statements. Warning: a
# pathologically low value (e.g. 1) also times out connection setup and can
# prevent any DB connection from establishing.
# BUZZ_DB_STATEMENT_TIMEOUT_MS=0

# -----------------------------------------------------------------------------
# Typesense (search)
# -----------------------------------------------------------------------------
TYPESENSE_API_KEY=buzz_dev_key
TYPESENSE_URL=http://localhost:8108

# -----------------------------------------------------------------------------
# Relay (WebSocket server)
# -----------------------------------------------------------------------------
# Bind address for the relay (host:port)
BUZZ_BIND_ADDR=0.0.0.0:3000
# Public WebSocket URL — used in NIP-42 auth challenges
RELAY_URL=ws://localhost:3000
# Stable relay signing key (required). `just bootstrap` generates a random key in
# the gitignored .env file. Preserve that value across restarts and backups.
# BUZZ_RELAY_PRIVATE_KEY=<32-byte hex private key>
# Directory the relay serves as the app (the product architecture: one
# origin for app + relay). Build it with `just app-build`.
BUZZ_WEB_DIR=./app/dist
# Serve the app at "/" (client-side routing). Without this the root path
# content-negotiates to the relay info document for plain HTTP.
BUZZ_WEB_SPA=full
# BUZZ_SERVE_GIT_WEB_GUI=true
# BUZZ_WEB_SPA=full  # fall back to index.html for every non-server path (client-side routing)
# Serve the unauthenticated GET /communities directory (lists every hosted
# community's host, icon and member count). Off by default; enable only for a
# deployment that is meant to be browsable.
# BUZZ_PUBLIC_COMMUNITY_DIRECTORY=1
# LLM gateway for browser agents: /llm/chat/completions forwards to this
# OpenAI-compatible upstream, injecting BUZZ_LLM_API_KEY server-side (the
# browser never sees the key). Unset = gateway returns 404. Callers are
# authenticated community members and are metered: a per-minute rate limit,
# a per-day call cap (or the agent's own kind:37012 `llmCalls` budget when one
# covers it), a clamped `max_tokens`, and an optional pinned model.
# BUZZ_LLM_PROXY_URL=https://your-llm-host/v1/chat/completions  # or a local LLM host
# BUZZ_LLM_API_KEY=local
# BUZZ_LLM_RATE_PER_MIN=20        # per-caller calls per minute
# BUZZ_LLM_MAX_CALLS_PER_DAY=500  # per-caller daily cap when no budget covers the caller
# BUZZ_LLM_MAX_CALLS_PER_DAY_TOTAL=2000  # daily cap for the whole community, all accounts together (bounds the bill)
# BUZZ_LLM_MAX_TOKENS=4096        # ceiling on max_tokens per request
# BUZZ_LLM_MODEL=                 # pin the upstream model; overrides the caller's
# Prices, US cents per million tokens (decimals allowed), so a budget's
# `llmCostCents` limit can be enforced from the upstream's reported token usage.
# Leave unset and any agent covered by a cost budget is refused (503) rather
# than run unmetered.
# BUZZ_LLM_PRICE_INPUT_CENTS_PER_MTOK=15
# BUZZ_LLM_PRICE_OUTPUT_CENTS_PER_MTOK=60

# -----------------------------------------------------------------------------
# Contribution classifier (`buzz org contribute classify`)
# -----------------------------------------------------------------------------
# OpenAI-compatible endpoint used to draft kind:37013 contribution records
# from completed kind:44011 tasks. Missing URL or key makes the command fail
# closed (no silent local fallback); the model defaults to deepseek-v4-flash-0731.
# BUZZ_CLASSIFIER_API_URL=
# BUZZ_CLASSIFIER_API_KEY=
# BUZZ_CLASSIFIER_MODEL=

# NIP-PL mobile push is an explicit deployment opt-in. A gateway URL alone
# never enables it. When enabled, the exact HTTP(S) delivery URL is required.
BUZZ_PUSH_ENABLED=false
BUZZ_PUSH_GATEWAY_DELIVERY_URL=https://push.buzz.xyz/v1/deliveries/apns

# -----------------------------------------------------------------------------
# Admin API (private moderation surface)
# -----------------------------------------------------------------------------
# Host name that serves the moderation API (/api/admin/v1). Leave unset to keep the admin surface absent.
# BUZZ_ADMIN_HOST=admin.localhost:3000
#
# Authentication mode. Accepted values: nip98 (default), disabled.
# Any other value is a startup error. Token authentication was removed:
# BUZZ_ADMIN_TOKEN is ignored with a startup warning — remove it from the environment.
# BUZZ_ADMIN_AUTH=nip98
#
# Option A — BUZZ_ADMIN_AUTH=nip98 (Nostr pubkey-based auth, default):
# NIP-98 HTTP Auth. Each request must carry an Authorization: Nostr header
# with a signed kind-27235 event. Authorized principals are resolved from:
#   1. RELAY_OPERATOR_PUBKEYS — comma-separated 64-char hex pubkeys (config Operators).
#   2. RELAY_OWNER_PUBKEY — implicit Operator fallback when RELAY_OPERATOR_PUBKEYS is unset.
#   3. relay_operators table — DB-managed Operator/Moderator roster.
# The admin API takes NIP-98 requests signed by one of those keys.
# Setting RELAY_OPERATOR_PUBKEYS for the admin console does NOT require
# RELAY_OPERATOR_API_ORIGIN; that origin is only for community provisioning
# (see below). When BUZZ_ADMIN_HOST is set, the relay advertises the admin
# origin in its NIP-11 document (`admin_api` field) so clients can auto-discover
# the console without manual URL entry.
# RELAY_OPERATOR_PUBKEYS=<64-char hex pubkey>[,<64-char hex pubkey>...]
#
# Option B — BUZZ_ADMIN_AUTH=disabled (read-only, no authentication):
# Anyone who can reach the relay can read, in every community: reports (with
# reporter notes and reported message content, deleted included), feedback and
# attachments, bans and timeouts with reasons, the community directory, member
# search and profiles (not staff status), and any stored message by ID.
# Writes and staffing are refused.
# Only people allowed to see all of that should be able to reach it. The admin
# API is on the relay's main listener and its hostname check uses the caller's
# Host header, so the whole relay port must be private, not just the admin
# hostname. The relay logs a WARN on every startup.
#
# Canonical origin (http(s)://host[:port], no path) that community-provisioning
# NIP-98 requests are verified against. Required only to USE the provisioning
# endpoints (POST /operator/communities) — not for the admin console. When
# RELAY_OPERATOR_PUBKEYS is set but this is unset, the relay boots with a WARN
# and provisioning requests fail closed until it is set.
# RELAY_OPERATOR_API_ORIGIN=http://127.0.0.1:3000

# Self-serve communities: let anyone with a signing key start a community of their own. Someone who
# picks the name `acme` gets `acme.<this domain>`, owned by them. Off unless this is set; needs
# RELAY_OPERATOR_API_ORIGIN (the signed create request is checked against it). Use a bare host:
# `localhost:3000` for a local run (browsers send `*.localhost` to your machine), your own domain
# in production, which also needs a wildcard DNS record and certificate for `*.<domain>`.
# BUZZ_SELF_SERVE_COMMUNITY_DOMAIN=localhost:3000
# The most communities this makes across the whole deployment in an hour (default 30). A key costs
# nothing to make, so this, not a per-person limit, is what stops a script.
# BUZZ_SELF_SERVE_MAX_PER_HOUR=30

# Anyone in a community may start a board; someone who is not an owner or admin may start at most this many a day
# (boards since deleted still count). 0 turns the limit off. Chat rooms are not counted.
# BUZZ_BOARDS_PER_PERSON_PER_DAY=5

# An account this server first heard from less than BUZZ_NEW_ACCOUNT_HOURS ago may send at most this many posts,
# board posts and board replies an hour (votes and chat are not counted; owners and admins are not limited). 0 = off.
# BUZZ_NEW_ACCOUNT_POSTS_PER_HOUR=20
# BUZZ_NEW_ACCOUNT_HOURS=24
# The same accounts may also save at most this many project records (a project's own record and every update, task step,
# ask to join or answer that names one) in all of that first day (default 60; 0 turns it off). Keys cost nothing to make,
# so on an open server this is what keeps a script of fresh accounts from filling projects with records.
# BUZZ_NEW_ACCOUNT_PROJECT_RECORDS_PER_DAY=60
# Whether the same accounts may upload files in that first day (default true: they may). The server keeps no count of the
# bytes each account stored, only a per-minute rate, so on an open server set this to false until a storage quota exists.
# Owners and admins are not held to it; reading files is not affected.
# BUZZ_NEW_ACCOUNT_MEDIA_UPLOADS=true

# Show the money screens without rebuilding the app. true or false is advertised in the server's
# information document (`investing`); leave it unset to say nothing, and the build decides (off unless a build named a
# network). The addresses the screens read still come from the build. Off by default.
# BUZZ_INVESTING=false
# The most communities one person may own (default 50).
# BUZZ_MAX_COMMUNITIES_PER_OWNER=50

# Deployment-global operator-listener routes. Each configured Nostr identity
# may register target pubkeys and receives mention notifications at its URL.
# Format: pubkey:deliveryUrl;pubkey:deliveryUrl
# BUZZ_OPERATOR_LISTENER_TIMEOUT_MS=5000
# BUZZ_OPERATOR_LISTENERS=<64-char hex pubkey>:https://listener.example/mentions

# Optional relay-owned KLIPY key. When set, NIP-11 advertises GIF search and
# signed-in clients use this relay as the metadata/search proxy.
# Keep the real value in your deployment's secret manager; never commit it.
# BUZZ_KLIPY_API_KEY=

# Shared Redis-backed admission limits. Defaults shown below; each value must
# be a positive integer.
# BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=60
# BUZZ_RATE_LIMIT_GIF_SEARCHES_PER_MIN=30
# BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=300
# BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=10
# BUZZ_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN=120
# BUZZ_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN=600
# BUZZ_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN=300
# BUZZ_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN=600

# -----------------------------------------------------------------------------
# Git (NIP-34 bare repositories)
# -----------------------------------------------------------------------------
# Root directory for ephemeral Git workspaces and the disposable pack cache.
# Default: ./repos (relative to CWD).
# BUZZ_GIT_REPO_PATH=./repos
# BUZZ_GIT_MAX_PACK_BYTES=524288000
# BUZZ_GIT_MAX_REPO_BYTES=1048576000
# Process-local immutable pack/index cache. Zero disables retention.
# BUZZ_GIT_PACK_CACHE_PATH=./repos/.pack-cache
# BUZZ_GIT_PACK_CACHE_MAX_BYTES=5368709120
# BUZZ_GIT_PACK_CACHE_MAX_CONCURRENT_POPULATIONS=2

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (media + Git/CAS)
# -----------------------------------------------------------------------------
# The local MinIO container is reachable from host processes at localhost:9000.
# Path style keeps the bucket in the URL path and is required by this local DNS
# setup. Use `virtual` only when the provider requires bucket-as-subdomain URLs.
BUZZ_S3_ENDPOINT=http://localhost:9000
BUZZ_S3_ACCESS_KEY=buzz_dev
BUZZ_S3_SECRET_KEY=buzz_dev_secret
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_REGION=us-east-1
BUZZ_S3_ADDRESSING_STYLE=path

# -----------------------------------------------------------------------------
# Media Upload Admission
# -----------------------------------------------------------------------------
# Bound image/video parser and storage work admitted by one relay process.
# BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS=8
# BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY=2
# BUZZ_MEDIA_UPLOADS_PER_MINUTE=30
# GET/HEAD /media/* always require Blossom t=get auth and relay membership.
# BUZZ_REQUIRE_MEDIA_GET_AUTH and BUZZ_REQUIRE_MEDIA_READ_AUTH are no longer
# read; setting either (including to false) changes nothing and the relay warns
# about it at startup.

# -----------------------------------------------------------------------------
# Ephemeral Channels (TTL testing)
# -----------------------------------------------------------------------------
# Override the TTL for all ephemeral channels (in seconds). When set, any
# channel created with a TTL tag will use this value instead of the
# client-provided one. Unset to use the client-provided TTL.
# BUZZ_EPHEMERAL_TTL_OVERRIDE=60

# How often the reaper checks for expired ephemeral channels (default: 60s).
# BUZZ_REAPER_INTERVAL_SECS=5

# -----------------------------------------------------------------------------
# Passkeys (Apple activation) — the relay's half of the AASA chain
# -----------------------------------------------------------------------------
# The relay serves GET /.well-known/apple-app-site-association (Content-Type:
# application/json, Cache-Control: no-cache; Apple caches it ~24h) from these
# two values so a signed app can own a `webcredentials` domain.
# Unset team id = the route 404s.
# The Apple Team ID is public — it ships inside any signed build. Not a secret.
# BUZZ_PASSKEY_TEAM_ID=ABCDE12345
# Bundle id in the AASA apps entry.
# BUZZ_PASSKEY_BUNDLE_ID=xyz.creaton.app

# -----------------------------------------------------------------------------
# Logging / Tracing
# -----------------------------------------------------------------------------
RUST_LOG=buzz_relay=debug,buzz_datastore=info,buzz_db=debug,buzz_auth=debug,buzz_pubsub=debug,tower_http=debug
# Optional OpenTelemetry-only target filter. This is deliberately independent
# from RUST_LOG so log verbosity changes cannot break trace parentage.
# BUZZ_OTEL_FILTER=buzz_relay=info,buzz_datastore=info

# OTLP tracing endpoint (optional — leave unset to disable)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# buzz CLI identity
# -----------------------------------------------------------------------------
# Nostr private key (hex or bech32) the `buzz` CLI signs with.
# BUZZ_PRIVATE_KEY=<32-byte hex or nsec1… private key>
# Relay WebSocket URL the CLI connects to (the relay itself uses RELAY_URL above).
# BUZZ_RELAY_URL=ws://localhost:3000

# Optional relay join policy. Markdown is served by the relay so every join
# surface can present the same documents. Each document and the independent age
# attestation are optional; configuring any one enables policy acceptance.
# Drafts to finish with a lawyer: docs/policies/ (see its README). Sign-up shows them and asks people to agree.
# BUZZ_TERMS_OF_SERVICE_MARKDOWN="# Terms of Service\n\nFull terms here."
# BUZZ_PRIVACY_POLICY_MARKDOWN="# Privacy Policy\n\nFull policy here."
# BUZZ_AGE_ATTESTATION_REQUIRED=true

# SIWE onboarding (wallet -> npub binding). Enables POST /auth/siwe/*.
# BUZZ_EVM_AUTH=1
# BUZZ_EVM_CHAIN_ID=1
# BUZZ_EVM_RPC_URL=            # needed to accept smart-account (passkey account) wallet links and sign-ins:
#                              # the server asks the account's own isValidSignature; without it, only
#                              # ordinary wallets verify. Set BUZZ_EVM_CHAIN_ID to the chain it reads.
#
# Onchain spend-ceiling guard (`buzz org allowance check|spend`, NIP-ORG §37012
# `onchain` binding). Opt-in: with these unset, nothing else changes.
# BUZZ_EVM_RPC_URL=http://127.0.0.1:8545
# BUZZ_ALLOWANCE_CONTRACT=0x…  # deployed OrgAllowance.sol
# BUZZ_SPENDER_KEY=0x…         # authorized spender EVM key (spend path only)

# NIP-ORG grant-chain enforcement at ingest (kind:37011 org grants).
# On by default: each grant's attenuation, root standing, and expiry are
# verified before acceptance and any grant whose chain cannot be fully
# verified is rejected (fail closed). Set `off` only to store and forward
# grants unchanged (e.g. while importing a community). Who may publish org
# nodes and budgets is anchored to the owner/admin regardless of this switch.
# ORG_GRANT_ENFORCEMENT=on

# ── Dev chain (Anvil) ────────────────────────────────────────────────────────
# `just dev-chain` boots a local chain at http://127.0.0.1:8545 (chain id 31337).
# Addresses: `just dev-chain-status`. Everything below is public config: no
# secrets, no keys. (The app's own network settings are VITE_CREATON_*, set in
# app/.env.example or deploy/compose/.env.creaton.example.)
#
# Relay-side EVM reads/spend checks (existing keys) — point them at the dev
# chain while you develop against it:
# BUZZ_EVM_CHAIN_ID=31337
# BUZZ_EVM_RPC_URL=http://127.0.0.1:8545

# Sepolia testnet deploy (docs/sepolia-testnet.md). Never commit real values: put them in .env.
# The key must be a testnet-only key, used for nothing else, holding only test ETH. Without both, the script only rehearses
# on a local fork of Sepolia.
# SEPOLIA_RPC_URL=
# DEPLOYER_PRIVATE_KEY=

# ZeroDev hosted bundler/paymaster (wave 4c) — https://dashboard.zerodev.app
ZERODEV_PROJECT_ID=
ZERODEV_API_KEY=

# KernelFactory for the vendored v0.4.0 Kernel stack wired to EntryPoint v0.8
# (Sepolia value 0xa85d8816dab8c0d1a59cd0d04b1c2f43609d1319).
ZERODEV_KERNEL_FACTORY=
