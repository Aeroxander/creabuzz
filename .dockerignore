# Build outputs
target/
**/target/
desktop/src-tauri/target/

# Native non-relay UI builds (not part of the public image)
desktop/
mobile/

# Node artifacts (built inside the image; host outputs would invalidate cache)
node_modules/
**/node_modules/
web/dist/

# VCS, IDE, scratch
.git/
.github/
.gitignore
.gitattributes
.vscode/
.idea/
.scratch/
# Agent sessions' worktrees: whole copies of the repository (tens of GB)
.claude/

# Local environment / secrets — never want these in the build context, at any
# depth (web/.env.local would otherwise be baked into the web app's build)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
# A deployment's own state: its secrets and its backups (database dumps)
deploy/
*.pem
*.key
secrets/

# OS junk
.DS_Store
Thumbs.db

# CI artifacts and tooling that the image doesn't need
.cache/
coverage/
dist/
playwright-report/
test-results/
bin/
sidecars/

# Docs the image doesn't ship. examples/ stays — examples/countdown-bot is
# a Cargo workspace member, so cargo-chef needs its manifest. Markdown files
# inside crates (Cargo.toml `readme = ...`) likewise need to be present to
# avoid manifest warnings; the savings from excluding them are negligible.
docs/

# Old Dockerfile noise (this Dockerfile is THE source of truth now)
docker-compose.yml
docker-compose.*.yml
prometheus.yml

# Not part of the relay image: the contracts (636 MB with their libraries) and
# the separate services, which build on their own
contracts/
services/
# The Hermit toolchain cache (5 GB); the image brings its own toolchains
.hermit/
