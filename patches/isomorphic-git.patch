+  const error = new Error(`The download unpacks to more than the limit (${what}).`);
+  error.code = 'UnpackLimitError';
+  return error
+}
+
+function countUnpacked(limits, bytes) {
+  limits.produced += bytes;
+  if (limits.produced > limits.total) throw unpackLimitError('total')
+}
