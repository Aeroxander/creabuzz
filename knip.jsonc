// Unused-exports and orphan-files scan (D150, item #29 of DEPRECATION-2026-10-31.md).
// Run: `pnpm exec knip --no-progress` (part of `just app-check`, so `just check` runs it too).
// tsc's noUnusedLocals cannot see exports, which is how dead code survived earlier clean-ups.
// Keep the allowlist (`ignoreIssues`) short, and give every entry a reason.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "exports", "types", "duplicates"],
  "workspaces": {
    // Repo scripts import core modules, so they count as users.
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    // The new phone-first app (plan v2 milestone 6): its entry, its tests and its guard scripts.
    "app": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "tests/**/*.ts",
        "scripts/*.mjs",
        "public/sw.js"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.mjs",
        "tests/**/*.ts"
      ]
    },
    // Core publishes every file (`exports: "./*"`). Unused files are still reported. Unused exports are not, for now:
    // about 300 of them (295 when counted) lost their only users when the web and desktop clients were removed, and are the next cut. List them with
    // "includeEntryExports": true.
    "packages/creaton-core": {
      "entry": ["src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,mjs}"]
    }
  }
}
