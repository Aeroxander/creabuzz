// Unused-exports and orphan-files scan (D150, item #29 of DEPRECATION-2026-10-31.md).
// Run: `pnpm -C web check:unused` (part of `pnpm -C web check`, so `just check` runs it too).
// tsc's noUnusedLocals cannot see exports, which is how dead code survived earlier clean-ups.
// Keep the allowlist (`ignoreIssues`) short, and give every entry a reason.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "exports", "types", "duplicates"],
  "workspaces": {
    // Repo scripts import web and core modules (kernel checks, regen-kinds, simulate-raise), so they count as users.
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "web": {
      "entry": [
        "src/app/routes.ts",
        "src/**/*.test.mjs",
        "tests/**/*.{ts,mjs}",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx,mjs,css}",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,mjs}"
      ]
    },
    // Core publishes every file (`exports: "./*"`); still report exports no workspace imports.
    "packages/creaton-core": {
      "entry": ["src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,mjs}"],
      "includeEntryExports": true
    },
    // Desktop is outside the MVP and not scanned, but it imports core: every desktop file is an entry so its
    // imports count, and its own exports are never reported.
    "desktop": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  },
  "ignoreWorkspaces": ["admin-web"],
  "ignoreIssues": {
    // Generated by TanStack Router on every build; its type exports are the router's, not ours.
    "web/src/app/routeTree.gen.ts": ["types"],
    // shadcn/ui primitives: each file keeps the library's full component API (CardHeader, AlertDialogTrigger, ...).
    "web/src/shared/ui/{alert-dialog,badge,button,card}.tsx": [
      "exports",
      "types"
    ],
    // Desktop is not scanned (see above); its duplicate aliases are desktop's own clean-up.
    "desktop/src/**": ["duplicates"]
  }
}
