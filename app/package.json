{
  "name": "@creaton/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The new phone-first Creaton app (plan v2, section 6).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ./scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "screens": "playwright test --project=screens",
    "check": "biome check . && tsc --noEmit && pnpm check:copy && pnpm check:px-text && pnpm check:file-sizes",
    "check:copy": "node ./scripts/check-copy.mjs",
    "check:px-text": "node ./scripts/check-px-text.mjs",
    "check:file-sizes": "node ./scripts/check-file-sizes.mjs",
    "check:bundle-size": "node ./scripts/check-bundle-size.mjs",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@creaton/core": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.168.10",
    "lucide-react": "^1.0.0",
    "nostr-tools": "^2.23.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.1"
  }
}
