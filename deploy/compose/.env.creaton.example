# Creaton settings, added to the bundle's own .env.example (README.md, "Creaton"):
#   cat .env.example .env.creaton.example > .env
# then replace every CHANGE_ME in both parts. The upstream BUZZ_IMAGE line is not used once this is on.

# Build and run the Creaton image (compose.creaton.yml) instead of the upstream Buzz image.
BUZZ_COMPOSE_CREATON=true
# The image's name. `./run.sh build` builds it from this checkout; a machine too small to build it can load one built
# elsewhere under the same name (docker save / docker load).
CREATON_IMAGE=creaton-relay:local

# HTTPS through Caddy (compose.caddy.yml), with a certificate for BUZZ_DOMAIN. Set BUZZ_DOMAIN above to the server's
# host name, and RELAY_URL, BUZZ_MEDIA_BASE_URL, BUZZ_MEDIA_SERVER_DOMAIN and BUZZ_CORS_ORIGINS to the same host; open
# ports 80 and 443. Passkeys work only over HTTPS. The relay's own port is then not published (run.sh refuses to start
# if it is). Read from here, so no command can forget it.
BUZZ_COMPOSE_TLS=true

# Unread rooms and boards (the server's read-state API).
BUZZ_V1_ENABLED=true

# How much one signed-in person may send: reads and writes a second (over 5 seconds, all their tabs together), and
# writes a minute. compose.creaton.yml sets 40 and 300, above the relay's chat-sized default, because the web app's
# reads count too. Uncomment to change them.
# BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=40
# BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=300

# Backups are encrypted to this age PUBLIC key, so the server can make them every night and holds nothing that opens
# them. Make the key on your own computer, not here: `age-keygen -o creaton-backup.key`, keep that file in your password
# manager (never on this server), and put the public key it prints (the line starting age1) here. ./run.sh backup (and
# upgrade, which backs up first) refuses while this still says CHANGE_ME; start and restart do not need it.
# README.md, "First start", step 9. BUZZ_BACKUP_ALLOW_UNENCRYPTED=true makes plain backups for a local test only.
BUZZ_BACKUP_AGE_RECIPIENT=CHANGE_ME_age_public_key

# The terms and the privacy note shown at sign-up, as Markdown files (paths from this folder). Start from
# docs/policies/*-DRAFT.md; run.sh refuses a file that still has a draft's [placeholders]. Unset shows none, and
# run.sh warns on every start: do not invite anyone before both are set.
# BUZZ_TERMS_FILE=policies/terms.md
# BUZZ_PRIVACY_FILE=policies/privacy.md

# The "I am 18 years of age or older" box at sign-up, beside the terms box. On by default, because the terms and the
# privacy note say people must be 18. Change it only if counsel agrees; to switch it off, set it to false.
BUZZ_AGE_ATTESTATION_REQUIRED=true

# Agents signing in for a member (BUZZ_ALLOW_NIP_OA_AUTH): the bundle's .env.example turns it on, for command-line and
# hosted AI agents. The web app never signs in that way and the pilot runs no agents, so it is off here (this later line
# wins). Turn it on only when you run agents against this server.
BUZZ_ALLOW_NIP_OA_AUTH=false

# Open sign-up. The bundle's .env.example sets BUZZ_REQUIRE_RELAY_MEMBERSHIP=true (every community invite-only, the right
# shape for a first, invited pilot); this later line wins and opens the door: anyone who makes an account on this
# server may read and post, and the link to a project opens straight to it. A stranger on someone's project may ask to
# join it (one press) and may do nothing else on it until the founder accepts.
# What slows a script of fresh keys down, and what does not. New accounts are slowed for their first day: posts
# (BUZZ_NEW_ACCOUNT_POSTS_PER_HOUR) and project records (BUZZ_NEW_ACCOUNT_PROJECT_RECORDS_PER_DAY); 0 turns either off.
# That is a limit for each account, and an account costs nothing to make, so it is a slow-down and not a wall: a script
# of N fresh keys can still write N times the limit. Chat and reactions are not counted, and the server has no limit per
# network address. Files are the exception that matters most: the server keeps no count of the bytes each account has
# stored (only a per-minute rate), so with the door open the next line closes uploads to accounts in their first day.
# Do not delete it until a per-account storage quota exists; then people can upload after their first day.
# To keep the server invite-only instead, set this to true (RELAY_OWNER_PUBKEY and BUZZ_RELAY_PRIVATE_KEY are then
# required, as the bundle's .env.example says) and run `./run.sh restart`; the public-record setting below then lets
# visitors read public projects without an invite.
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_NEW_ACCOUNT_MEDIA_UPLOADS=false

# Show the money screens (Back, Take out, the allowance) without a rebuild: the server tells the app. Off by default.
# The app shows money only when this is true AND the app was built for a network (the section below). Set it to true on a
# test network, false to turn the money screens off whatever the build says. (The old web app's build-time switches,
# VITE_INVESTING and VITE_TRADING_TRIAL, are only its fallback when this line is absent.)
# BUZZ_INVESTING=false

# Anyone can read a public project's record. On for Creaton's own server, because a project's record is made to be
# shown: someone with no invite who opens a shared project or scorecard link sees that project's goal, weekly updates,
# promises kept and missed, and accepted work, read only, with a line saying that taking part needs an invite, and the
# link shows a real preview in a chat app. Only projects that are listed, not removed, and whose founder is neither
# muted nor banned; never a project marked "Not listed yet". A project that states the terms of a sale is public like
# any other.
# Exactly what the server gives them, and nothing else:
#   - the project's own record, whole: its name, pitch, picture and links, the account ids of its team and, when the
#     project carries them, its chain addresses and the terms of a sale it states (a price floor or price step, an
#     amount to raise, a monthly budget, Shares that unlock at a multiple of the price, or a sale's address). The page
#     shows only the name, picture and goal and a link's preview never carries a price, but the record is sent whole,
#     as the founder signed it;
#   - the founder's goals and promises with their answers, and the team's updates;
#   - for work the team accepted and did not send back: the task, the work handed in (its words, links and files) and
#     the confirmation. The helper's account id is on it.
# Kept for members: work handed in that is waiting or was sent back, and the reasons; asks for more time; offers of
# help and replies, asks to join; check notes; everything about on-chain work (submitted evidence, reviewers' reasons, agreements,
# work areas, challenges); and all rooms, boards, direct messages, profiles, Home, lists of projects or people.
# Posting stays for members.
# It matters only on an invite-only server (BUZZ_REQUIRE_RELAY_MEMBERSHIP=true, see above): with the door open, everyone
# reads everything a member could, so this line changes nothing until you close the door again. Keeping it on means a
# project stays public the day you do. On an invite-only server it covers every community this server hosts (one setting
# for the server, not one per community).
# If you later set that to false to let communities choose, a community that then chooses invite-only is NOT
# opened by this line (its owner has no way yet to choose public records), and that includes Creaton's own community.
# To turn it off, set it to false (or delete the line) and run `./run.sh restart`: a visitor with no invite is then
# told to ask for one, as before.
# Limits. A project's public record is read from the database at most once in BUZZ_PUBLIC_PROJECT_READS_CACHE_SECS
# (30) and everyone is answered from that, so a new update, a mute, a ban or a removal reaches visitors up to that
# much later (up to 5 minutes while the shared budget below is spent). Only those database reads count against the
# budget everyone without an invite shares, BUZZ_PUBLIC_PROJECT_READS_PER_MIN (300). One address may make
# BUZZ_PUBLIC_PROJECT_READS_PER_ADDRESS_MIN (120) public reads a minute; the address is the one the bundled Caddy
# proxy passes on (X-Forwarded-For), so behind another proxy make sure it sets that header itself.
BUZZ_PUBLIC_PROJECT_READS=true

# The server's own example project, so that someone with no account who lands on Home is offered "See a record" and can
# read a real one. Needs the line above (on an invite-only server such a visitor cannot find the project any other
# way). Fill it in after Creaton's own project is started (docs/v3-review/CREATON-EXAMPLE-PROJECT.md): it is the end of
# the project's shared address, what follows /p/ (the project's id, a dash, the first 16 characters of the founder's
# key), then run `./run.sh restart`. The server offers it only while that project is one a visitor can open; left
# unset, the button is simply not shown to them.
# BUZZ_EXAMPLE_PROJECT=creaton-0123456789abcdef

# Wallet links: a person's account linked to the address that signs for them on the chain. A passkey account is a
# contract, so the server asks the chain to check its signature (one bounded call per link); without a node it refuses
# passkey links, and contributor projects need them. Any Sepolia node, for example
# https://ethereum-sepolia-rpc.publicnode.com; this one stays on the server. scripts/sepolia-deploy.sh prints these
# three lines again: keep one copy.
# FOR THE FOUNDERS' PILOT (no chain: docs/v3-review/PILOT-RUNBOOK.md, "Pilot A"), leave these three lines commented out:
# starting a project, weekly updates, help requests and tasks are records on this server and need no chain. Uncomment them,
# and put a node in the last one, only for the contributor run (the runbook's "Second").
# BUZZ_EVM_AUTH=1
# BUZZ_EVM_CHAIN_ID=11155111
# BUZZ_EVM_RPC_URL=CHANGE_ME_SEPOLIA_NODE_URL

# ── The Creaton app on a test network (docs/next-version/DEPLOY-TEST-NETWORK.md, step by step) ─────────────────────
# Leave this whole section out and the server is the social app alone: no money screens. The money contracts are
# contracts/pot, deployed with YOUR OWN key by YOU (contracts/pot/DEPLOYMENTS.md); the play dollar deploys only on chain 31337
# (local) or 11155111 (Sepolia). Nothing here is a real deployment's address: every <...> is yours to fill in.
#
# What the image carries: runtime-creaton (the new app, the default) or runtime (the old web app; see the end of this file).
# CREATON_IMAGE_TARGET=runtime-creaton
#
# -- The app's network. They are read when the app is built, and are public in the page: `./run.sh build`, then `./run.sh restart`.
# Name the file the deploy script wrote (a path from this folder) and run.sh takes the chain id, the Launcher and the dollar
# from it; or set the three values by hand (a value set here wins over the file). The build refuses one without the other.
# CREATON_DEPLOYMENTS_FILE=../../contracts/pot/deployments/pot-<chain id>.json
# VITE_CREATON_CHAIN_ID=<11155111 for Sepolia>
# VITE_CREATON_LAUNCHER=<the Launcher's address>
# VITE_CREATON_DOLLAR=<the play dollar's address>
# A read-only node for the page, with a request limit, not the deployer's and not your server's own: every visitor's browser
# calls it. `./run.sh build` asks it for its network and for the Launcher's code and stops if it does not answer as the page needs.
# VITE_CREATON_RPC_URL=https://<a read-only node for this network>
# Phone accounts (a passkey, no wallet app) send through a bundler, and the fee is paid by a sponsor. Both addresses are public
# in the page, so each must be an address of a proxy that holds its own key: a key in the address is refused. The sponsor
# address is optional (the fee is then asked at the bundler); name the server's own /sponsor path to use its limit (below).
# VITE_CREATON_PASSKEY_ACCOUNT=1
# VITE_CREATON_BUNDLER_URL=https://<your bundler's address>
# VITE_CREATON_SPONSOR_URL=https://<this server's host>/sponsor
#
# -- The server's side. These are NOT built into the page; they are read by the running server (restart only).
# The money screens on (the section above this one describes the switch).
# BUZZ_INVESTING=true
# The chain reader: it reads the contracts and signs the numbers every project page shows. Needs a node that serves
# eth_chainId, eth_blockNumber, eth_getBlockByNumber, eth_getLogs (ranges up to BUZZ_CHAIN_LOG_RANGE, default 2000 blocks;
# lower it if the node refuses) and eth_call at past blocks (an archive node, or one that keeps the last few hours). Not the page's node.
# BUZZ_CHAIN_RPC_URL=https://<a node for the server, with a request limit>
# BUZZ_CHAIN_ID=<the same chain id>
# BUZZ_CHAIN_LAUNCHER=<the same Launcher address>
# The block the Launcher was deployed at (the first receipt in contracts/pot/broadcast/DeployPot.s.sol/<chain id>/run-latest.json):
# the reader starts there. Left out it starts at block 0 and reads the whole chain first.
# BUZZ_CHAIN_START_BLOCK=<block number>
# The chain reader's helper: a key that pays the gas of two calls anyone may make on a project (collect the platform's fee, settle
# money that has arrived). Its own new key, never one that holds anything else, and a little test ether on it. A SECRET: it
# is read from the environment of the server and from nowhere else; never commit this file's real copy. Left out the helper is off.
# BUZZ_CHAIN_HELPER_KEY=CHANGE_ME_helper_key
# The server's owner: the key whose public half runs seasons (`buzz launchpad seasons start`). 64 hex characters (public).
# RELAY_OWNER_PUBKEY=<the operator's public key in hex>
# Sponsored fees: the server puts a daily limit in front of YOUR sponsor (an address that holds its own key). Both or neither of
# this and BUZZ_CHAIN_RPC_URL. Limits (optional): BUZZ_SPONSOR_PER_ACCOUNT_PER_DAY, BUZZ_SPONSOR_TOTAL_PER_DAY,
# BUZZ_SPONSOR_PER_IP_PER_DAY, BUZZ_SPONSOR_EXIT_PER_IP_PER_DAY. A way out is never refused by the limit.
# BUZZ_SPONSOR_UPSTREAM_URL=https://<your sponsor's address>
# Alerts away from the app (web push): your own P-256 key (43 characters, made as docs/web-push-deployment.md says) and your own
# contact. SECRET key. Both or neither; they need BUZZ_CHAIN_RPC_URL too. Needs https (below).
# BUZZ_WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_push_key
# BUZZ_WEB_PUSH_SUBJECT=mailto:<your contact address>
# Phone accounts' wallet links: the server asks the chain to check a passkey account's signature. Uncomment the three
# BUZZ_EVM_* lines in "Wallet links" above (BUZZ_EVM_CHAIN_ID is the same chain id) when VITE_CREATON_PASSKEY_ACCOUNT=1.
# https: passkeys and alerts work only over HTTPS. BUZZ_COMPOSE_TLS=true (near the top of this file) does it with Caddy.

# ── OLD WEB APP ONLY: everything from here to the end of this file (the VITE_* lines without CREATON in them) ──────
# The image now carries the new Creaton app (CREATON_IMAGE_TARGET above), which ignores these lines. They are read only when
# CREATON_IMAGE_TARGET=runtime builds the old web app (web/). Leave them out for the new app.
#
# ── Contributor projects on Sepolia (docs/sepolia-testnet.md) ──────────────────────────────────────────────────────
# Leave this section as it is for the social app alone. After `scripts/sepolia-deploy.sh --broadcast`, copy the
# values it prints, then `./run.sh build` and `./run.sh restart`. These are public: they end up in the page.
# With a contributor kit set, `./run.sh build` first asks VITE_CHAIN_RPC_URL for its network and for the kit's history
# from the block below, and stops with the reason if the node does not answer as the page will need.
# The image is contributor-only: it takes no setting for test raises, whatever else is set below.
# VITE_LAUNCHPAD_CHAIN_ID=11155111
# VITE_CHAIN_RPC_URL=https://<a read-only Sepolia node for the page, with a request limit; not the deployer's>
# VITE_CONTRIBUTOR_KITS={"11155111":"<contributor-kit>"}
# VITE_HISTORY_FROM_BLOCKS={"11155111":<the block the kits were deployed at>}
# The fees of passkey accounts, paid by a ZeroDev paymaster: contributor steps then work from a passkey account alone.
# VITE_ZERODEV_PROJECT_ID=
# VITE_ZERODEV_CHAIN_ID=11155111
# Error reports from the app (docs/error-reporting.md). Optional for the social app alone; with contributor projects on,
# the build warns without it (the pilot runbook relies on them).
# VITE_ERROR_REPORT_URL=https://<your collector>

# ── The weekly-sale trial build (Sepolia only; docs/sepolia-testnet.md, "Trading") ─────────────────────────────────────
# Leave this whole block out for the real pilot: with none of it set the image shows no trading and no features beyond the
# pilot's. `scripts/sepolia-deploy-v5.sh --broadcast` prints the lines with the real addresses; paste them here, then
# `./run.sh build` and `./run.sh restart`. Trading shows only with BOTH of the first two lines set; `./run.sh build`
# (and the image's own check) refuses one without the other, and either without VITE_CHAIN_RPC_URL and VITE_CONTRIBUTOR_KITS.
# The contributor kit here is the weekly-sale kit, not the 5 Nov one (projects started on that one never get a market).
# VITE_SECONDARY_MARKET_FACTORY={"11155111":"<market-factory>"}
# VITE_TRADING_TRIAL=1
# The free-mint test token the trial trades in: anyone can mint it, so its prices mean nothing.
# VITE_TEST_QUOTE_TOKENS={"11155111":"<test-quote-token>"}
# Features that work with the new set. The work bounty and the payouts factory are the NEW ones from the weekly-sale
# deploy; the rest are the 5 Nov addresses and stay as they are (the court needs the CREATE token; remix bonds need the court).
# VITE_WORK_BOUNTIES={"11155111":"<work-bounty>"}
# VITE_PAYOUTS_FACTORIES={"11155111":"<payouts-factory>"}
# VITE_OPEN_BOUNTIES={"11155111":"<open-bounty>"}
# VITE_CREATE_TOKENS={"11155111":"<create-token>"}
# VITE_CREATE_FAUCETS={"11155111":"<create-faucet>"}
# VITE_COURTS={"11155111":"<court>"}
# VITE_REMIX_BONDS={"11155111":"<remix-bonds>"}
# ── Investing (Sepolia only; docs/v3-review/INVESTING-SWITCH.md) ───────────────────────────────────────────────────────
# ONE switch, off by default. Leave this block out and nothing money-related changes. With VITE_INVESTING=1 and the three
# addresses below, a project shows a Backing block, Home's feed shows backing cards, You shows your positions, and a project
# set up from the Start page is made with a backing pool. It works in this contributor-only image too, for these places
# only. The four lines go together: `./run.sh build` (and the image's own check) refuses the switch with an address missing,
# an address without the switch, and either one without the chain node and history block set above.
# `contracts/script/DeployBackingSepolia.s.sol` writes `contracts/deployments/backing-sepolia-11155111.json`: the addresses
# are its roles `backing-pool-factory`, `contributor-kit-v3` and `backing-quote-token`. Paste them here, then
# `./run.sh build` and `./run.sh restart`. VITE_TEST_QUOTE_TOKENS (in the trial block above) adds a "Get test tokens" button
# when backers pay in the free test token.
# VITE_INVESTING=1
# VITE_BACKING_POOL_FACTORY={"11155111":"<backing-pool-factory>"}
# VITE_CONTRIBUTOR_KIT_V3={"11155111":"<contributor-kit-v3>"}
# VITE_BACKING_QUOTE_TOKEN={"11155111":"<backing-quote-token>"}
# The optional AI helpers need no rebuild: see README.md ("AI helpers") for BUZZ_LLM_PROXY_URL, BUZZ_LLM_API_KEY and
# BUZZ_LLM_MODEL, which go in the server's part of .env, not here.
