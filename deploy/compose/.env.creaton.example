# Creaton settings, added to the bundle's own .env.example (README.md, "Creaton"):
#   cat .env.example .env.creaton.example > .env
# then replace every CHANGE_ME in both parts. The upstream BUZZ_IMAGE line is not used once this is on.

# Build and run the Creaton image (compose.creaton.yml) instead of the upstream Buzz image.
BUZZ_COMPOSE_CREATON=true
# The image's name. `./run.sh build` builds it from this checkout; a machine too small to build it can load one built
# elsewhere under the same name (docker save / docker load).
CREATON_IMAGE=creaton-relay:local

# HTTPS through Caddy (compose.caddy.yml), with a certificate for BUZZ_DOMAIN. Set BUZZ_DOMAIN above to the server's
# host name, and RELAY_URL, BUZZ_MEDIA_BASE_URL, BUZZ_MEDIA_SERVER_DOMAIN and BUZZ_CORS_ORIGINS to the same host; open
# ports 80 and 443. Passkeys work only over HTTPS. The relay's own port is then not published (run.sh refuses to start
# if it is). Read from here, so no command can forget it.
BUZZ_COMPOSE_TLS=true

# Unread rooms and boards (the server's read-state API).
BUZZ_V1_ENABLED=true

# How much one signed-in person may send: reads and writes a second (over 5 seconds, all their tabs together), and
# writes a minute. compose.creaton.yml sets 40 and 300, above the relay's chat-sized default, because the web app's
# reads count too. Uncomment to change them.
# BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=40
# BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=300

# Backups are encrypted to this age PUBLIC key, so the server can make them every night and holds nothing that opens
# them. Make the key on your own computer, not here: `age-keygen -o creaton-backup.key`, keep that file in your password
# manager (never on this server), and put the public key it prints (the line starting age1) here. ./run.sh backup (and
# upgrade, which backs up first) refuses while this still says CHANGE_ME; start and restart do not need it.
# README.md, "First start", step 9. BUZZ_BACKUP_ALLOW_UNENCRYPTED=true makes plain backups for a local test only.
BUZZ_BACKUP_AGE_RECIPIENT=CHANGE_ME_age_public_key

# The terms and the privacy note shown at sign-up, as Markdown files (paths from this folder). Start from
# docs/policies/*-DRAFT.md; run.sh refuses a file that still has a draft's [placeholders]. Unset shows none, and
# run.sh warns on every start: do not invite anyone before both are set.
# BUZZ_TERMS_FILE=policies/terms.md
# BUZZ_PRIVACY_FILE=policies/privacy.md

# The "I am 18 years of age or older" box at sign-up, beside the terms box. On by default, because the terms and the
# privacy note say people must be 18. Change it only if counsel agrees; to switch it off, set it to false.
BUZZ_AGE_ATTESTATION_REQUIRED=true

# Agents signing in for a member (BUZZ_ALLOW_NIP_OA_AUTH): the bundle's .env.example turns it on, for command-line and
# hosted AI agents. The web app never signs in that way and the pilot runs no agents, so it is off here (this later line
# wins). Turn it on only when you run agents against this server.
BUZZ_ALLOW_NIP_OA_AUTH=false

# Server-wide, the bundle's .env.example sets BUZZ_REQUIRE_RELAY_MEMBERSHIP=true: every community is invite-only, the
# right shape for a first, invited pilot. Set it to false later to let communities choose (docs/self-serve-communities.md).

# Wallet links: a person's account linked to the address that signs for them on the chain. A passkey account is a
# contract, so the server asks the chain to check its signature (one bounded call per link); without a node it refuses
# passkey links, and contributor projects need them. Any Sepolia node, for example
# https://ethereum-sepolia-rpc.publicnode.com; this one stays on the server. scripts/sepolia-deploy.sh prints these
# three lines again: keep one copy.
BUZZ_EVM_AUTH=1
BUZZ_EVM_CHAIN_ID=11155111
BUZZ_EVM_RPC_URL=CHANGE_ME_SEPOLIA_NODE_URL

# ── Contributor projects on Sepolia (docs/sepolia-testnet.md) ──────────────────────────────────────────────────────
# Leave this section as it is for the social app alone. After `scripts/sepolia-deploy.sh --broadcast`, copy the
# values it prints, then `./run.sh build` and `./run.sh restart`. These are public: they end up in the page.
# With a contributor kit set, `./run.sh build` first asks VITE_CHAIN_RPC_URL for its network and for the kit's history
# from the block below, and stops with the reason if the node does not answer as the page will need.
# The image is contributor-only: it takes no setting for test raises, whatever else is set below.
# VITE_LAUNCHPAD_CHAIN_ID=11155111
# VITE_CHAIN_RPC_URL=https://<a read-only Sepolia node for the page, with a request limit; not the deployer's>
# VITE_CONTRIBUTOR_KITS={"11155111":"<contributor-kit>"}
# VITE_HISTORY_FROM_BLOCKS={"11155111":<the block the kits were deployed at>}
# The fees of passkey accounts, paid by a ZeroDev paymaster: contributor steps then work from a passkey account alone.
# VITE_ZERODEV_PROJECT_ID=
# VITE_ZERODEV_CHAIN_ID=11155111
# Error reports from the app (docs/error-reporting.md). Optional for the social app alone; with contributor projects on,
# the build warns without it (the pilot runbook relies on them).
# VITE_ERROR_REPORT_URL=https://<your collector>

# ── The weekly-sale trial build (Sepolia only; docs/sepolia-testnet.md, "Trading") ─────────────────────────────────────
# Leave this whole block out for the real pilot: with none of it set the image shows no trading and no features beyond the
# pilot's. `scripts/sepolia-deploy-v5.sh --broadcast` prints the lines with the real addresses; paste them here, then
# `./run.sh build` and `./run.sh restart`. Trading shows only with BOTH of the first two lines set; `./run.sh build`
# (and the image's own check) refuses one without the other, and either without VITE_CHAIN_RPC_URL and VITE_CONTRIBUTOR_KITS.
# The contributor kit here is the weekly-sale kit, not the 5 Nov one (projects started on that one never get a market).
# VITE_SECONDARY_MARKET_FACTORY={"11155111":"<market-factory>"}
# VITE_TRADING_TRIAL=1
# The free-mint test token the trial trades in: anyone can mint it, so its prices mean nothing.
# VITE_TEST_QUOTE_TOKENS={"11155111":"<test-quote-token>"}
# Features that work with the new set. The work bounty and the payouts factory are the NEW ones from the weekly-sale
# deploy; the rest are the 5 Nov addresses and stay as they are (the court needs the CREATE token; remix bonds need the court).
# VITE_WORK_BOUNTIES={"11155111":"<work-bounty>"}
# VITE_PAYOUTS_FACTORIES={"11155111":"<payouts-factory>"}
# VITE_OPEN_BOUNTIES={"11155111":"<open-bounty>"}
# VITE_CREATE_TOKENS={"11155111":"<create-token>"}
# VITE_CREATE_FAUCETS={"11155111":"<create-faucet>"}
# VITE_COURTS={"11155111":"<court>"}
# VITE_REMIX_BONDS={"11155111":"<remix-bonds>"}
# The optional AI helpers need no rebuild: see README.md ("AI helpers") for BUZZ_LLM_PROXY_URL, BUZZ_LLM_API_KEY and
# BUZZ_LLM_MODEL, which go in the server's part of .env, not here.
