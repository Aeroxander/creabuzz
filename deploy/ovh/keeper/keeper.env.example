# /etc/creaton-keeper/keeper.env: read by systemd as root (keep it mode 0600, owner root). install.sh creates it from this
# file the first time and leaves it alone after that.
#
# The Sepolia node the keeper reads the market from and sends through. The keeper hands it to `cast` on the command line,
# so other users of this machine could see it in the process list: use a node key made for this, with a request limit,
# and never the deployer's. It can be the same provider as the server's BUZZ_EVM_RPC_URL.
RPC_URL=CHANGE_ME_SEPOLIA_NODE_URL
